#!/bin/bash
# Launcher for nubuntu-utils snap commands.
# If a bespoke wrapper exists for the command, run it; otherwise forward the
# command and its arguments to the underlying Nushell command of the same name
# via the generic forwarder (wrappers/_forward.nu).
cmd="$1"; shift
if [ -f "$SNAP/wrappers/$cmd.nu" ]; then
    exec "$SNAP/bin/nu" --include-path "$SNAP" "$SNAP/wrappers/$cmd.nu" "$@"
fi
exec "$SNAP/bin/nu" --include-path "$SNAP" "$SNAP/wrappers/_forward.nu" "$cmd" "$@"
